# Database (PostgreSQL with pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=career_pathfinder
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/career_pathfinder

# Graph Database (Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# ──────────────────────────────────────────────
# LLM Provider Switch (change this ONE variable)
# ──────────────────────────────────────────────
# "claude"      → Claude / Anthropic native API via LLMsRelay (configured below)
# "ollama"      → local Ollama instance (llama3:latest, qwen2.5-coder:14b, etc.)
# "antigravity" → free, routes through Antigravity reverse proxy
# "anthropic"   → paid, uses direct Anthropic API with ANTHROPIC_API_KEY below
# "mock"        → offline deterministic responses (no API needed)
LLM_PROVIDER=claude

# Claude / LLMsRelay API (Backend-only, never commit your key)
# Get your API key from LLMsRelay / Anthropic and configure below
CLAUDE_API_KEY=<YOUR_LLMSRELAY_API_KEY>
CLAUDE_BASE_URL=https://api.llmsrelay.com
CLAUDE_MODEL=<YOUR_CONFIGURED_CLAUDE_MODEL>

# Anthropic Direct API (kept for established/backward compatibility)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Antigravity Proxy (only used when LLM_PROVIDER=antigravity)
# To start the proxy, run these commands to create a custom network (avoids Wi-Fi IP clashes & permission errors):
#   docker network create --subnet=192.168.99.0/24 antigravity-net 2>/dev/null
#   docker run -d --net=antigravity-net --ip=192.168.99.2 --user root -p 3001:3000 -e BASE_URL=http://localhost:3001 --name antigravity-proxy frieserpaldi/antigravity-proxy:0.7.0
#
# Then open http://localhost:3001 in your browser to add Google account.
#
# Available model IDs (from proxy dashboard):
#   gemini-3.6-flash-high   | gemini-3.6-flash-medium   | gemini-3.6-flash-low
#   gemini-3.5-flash-low    | gemini-3.5-flash-extra-low
#   gemini-3.1-pro-high     | gemini-3.1-pro-low
ANTIGRAVITY_PROXY_URL=http://localhost:3001/v1
ANTIGRAVITY_MODEL=gemini-3.6-flash-medium

# Auth (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Security & JWT Authentication
JWT_SECRET_KEY=your_secure_random_jwt_secret_key_min_32_chars

# Default Platform Admin Credentials (Configured securely via environment)
DEFAULT_ADMIN_EMAIL=admin@aven.com
DEFAULT_ADMIN_PASSWORD=your_strong_admin_password_here
NEXT_PUBLIC_DEMO_ADMIN_EMAIL=admin@aven.com
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=your_strong_admin_password_here
